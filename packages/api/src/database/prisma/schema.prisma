  asset_out            String   @db.VarChar
  amount_out           Decimal  @db.Decimal
  batcher_fee          Decimal  @db.Decimal
  sender               String   @db.VarChar
  sender_stake_address String?  @db.VarChar
  receiver             String   @db.VarChar
